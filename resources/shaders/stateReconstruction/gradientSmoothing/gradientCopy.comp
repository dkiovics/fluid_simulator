#version 460 compatibility
precision highp float;

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct ParticleSSBOData
{
	vec4 posAndDensity;
	vec4 velocity;
};

layout(std430, binding = 2) restrict buffer GradientSSBO {
	ParticleSSBOData gradient[];
};

layout(std430, binding = 3) restrict readonly buffer GradientTmpSSBO {
	vec4 gradientTmp[];
};


void main() {
	uint pIdx = gl_GlobalInvocationID.x;
	if (pIdx >= gradient.length()) return;

	// Replace only the xyz position-gradient with the smoothed value; preserve
	// the .w density-gradient component and the velocity vec4 untouched.
	gradient[pIdx].posAndDensity.xyz = gradientTmp[pIdx].xyz;
}
