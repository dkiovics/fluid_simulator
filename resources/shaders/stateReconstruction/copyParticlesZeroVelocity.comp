#version 460 compatibility
precision highp float;

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct ParticleSSBOData
{
	vec4 posAndDensity;
	vec4 velocity;
};

layout(std430, binding = 0) restrict readonly buffer SrcSSBO {
	ParticleSSBOData src[];
};

layout(std430, binding = 1) restrict writeonly buffer DstSSBO {
	ParticleSSBOData dst[];
};


void main() {
	uint i = gl_GlobalInvocationID.x;
	if (i >= src.length()) return;

	// Copy the (reconstructed) position + density verbatim, but reset velocity
	// to zero so the simulator restarts from rest rather than inheriting stale
	// velocities from before reconstruction began.
	dst[i].posAndDensity = src[i].posAndDensity;
	dst[i].velocity = vec4(0.0);
}
