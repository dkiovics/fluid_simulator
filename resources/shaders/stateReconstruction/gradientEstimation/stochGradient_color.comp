#version 460 core
#extension GL_NV_shader_atomic_float : enable
precision highp float;

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

uniform ivec2 screenSize;

uniform sampler2D referenceImage;
uniform sampler2D plusPertImage;
uniform sampler2D minusPertImage;

struct ParticleData {
    vec4 posAndDensity;
	vec4 velocity;
};

layout(std430, binding = 0) restrict readonly buffer paramNegativeOffsetsSSBO {
	ParticleData paramNegativeOffsets[];
};

layout(std430, binding = 1) restrict readonly buffer paramPositiveOffsetsSSBO {
	ParticleData paramPositiveOffsets[];
};

layout(std430, binding = 2) restrict buffer gradientSSBO {
	ParticleData gradient[];
};

layout(std430, binding = 20) restrict readonly buffer XCountBuffer { uint xCount[]; };
layout(std430, binding = 21) restrict readonly buffer XOffsetBuffer { uint xOffset[]; };
layout(std430, binding = 22) restrict readonly buffer XIndexBuffer { int xIndex[]; };
layout(std430, binding = 23) restrict readonly buffer YRadiusBuffer { int yRadius[]; };


void accumulateGradient(int particleId, float positiveError, float negativeError) {
	vec4 signedPerturbation = paramPositiveOffsets[particleId].posAndDensity - paramNegativeOffsets[particleId].posAndDensity;

	if(signedPerturbation.x != 0.0)
		atomicAdd(gradient[particleId].posAndDensity.x, (positiveError - negativeError) / signedPerturbation.x);
	if(signedPerturbation.y != 0.0)
		atomicAdd(gradient[particleId].posAndDensity.y, (positiveError - negativeError) / signedPerturbation.y);
	if(signedPerturbation.z != 0.0)
		atomicAdd(gradient[particleId].posAndDensity.z, (positiveError - negativeError) / signedPerturbation.z);
	if(signedPerturbation.w != 0.0)
		atomicAdd(gradient[particleId].posAndDensity.w, (positiveError - negativeError) / signedPerturbation.w);

	signedPerturbation = paramPositiveOffsets[particleId].velocity - paramNegativeOffsets[particleId].velocity;

	if(signedPerturbation.x != 0.0)
		atomicAdd(gradient[particleId].velocity.x, (positiveError - negativeError) / signedPerturbation.x);
	if(signedPerturbation.y != 0.0)
		atomicAdd(gradient[particleId].velocity.y, (positiveError - negativeError) / signedPerturbation.y);
	if(signedPerturbation.z != 0.0)
		atomicAdd(gradient[particleId].velocity.z, (positiveError - negativeError) / signedPerturbation.z);
	if(signedPerturbation.w != 0.0)
		atomicAdd(gradient[particleId].velocity.w, (positiveError - negativeError) / signedPerturbation.w);
}


void main(void) {
	ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
	if(pos.x >= screenSize.x || pos.y >= screenSize.y)
		return;
	// Column-major pixel layout (see bilateral_x.frag): Y-neighbours have consecutive
	// pixIdx values, so the Y-walk below reads xCount/xOffset/xIndex contiguously.
	int index = pos.x * screenSize.y + pos.y;

	int r = yRadius[index];
	uint centerCount = xCount[index];
	if(r == 0 && centerCount == 0u)
		return;

	vec3 referenceColor = texture(referenceImage, (vec2(pos) + vec2(0.5)) / vec2(screenSize)).xyz;
	vec3 plusPertColor = texelFetch(plusPertImage, pos, 0).xyz;
	vec3 minusPertColor = texelFetch(minusPertImage, pos, 0).xyz;

	float positiveError = dot(referenceColor - plusPertColor, referenceColor - plusPertColor);
	float negativeError = dot(referenceColor - minusPertColor, referenceColor - minusPertColor);

	// Slot 0 of each pixel is the spray sentinel: -1 if non-spray, sprayID if spray.
	// If center is spray, use only that single ID; otherwise walk the Y-kernel and
	// read slots 1..xc-1 of each neighbor (skipping their slot 0 to avoid spray
	// contamination of surface pixels' walks).
	if(centerCount > 0u){
		uint centerInclusive = xOffset[index];
		uint centerStart = centerInclusive - centerCount;
		int centerFirst = xIndex[centerStart];
		if(centerFirst >= 0){
			accumulateGradient(centerFirst, positiveError, negativeError);
			return;
		}
	}

	for(int p = -r; p <= r; p++){
		int neighborY = pos.y + p;
		if(neighborY < 0 || neighborY >= screenSize.y)
			continue;
		int npx = pos.x * screenSize.y + neighborY;
		uint xc = xCount[npx];
		if(xc == 0u)
			continue;
		uint inclusive = xOffset[npx];
		uint start = inclusive - xc;
		// Skip slot 0 (spray sentinel). If neighbor is spray, slot 0 is sprayID and
		// slots 1..xc-1 is empty (xc=1) � neighbor contributes nothing to a non-spray walk.
		for(uint q = 1u; q < xc; q++){
			int particleId = xIndex[start + q];
			if(particleId < 0)
				continue;
			accumulateGradient(particleId, positiveError, negativeError);
		}
	}
}
